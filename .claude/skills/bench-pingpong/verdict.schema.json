{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "prior_findings", "findings", "decisions"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "REVISE"],
      "description": "blocker/major 지적이 하나라도 남아 있으면 REVISE"
    },
    "summary": {
      "type": "string",
      "description": "이번 라운드 판단 요약 (한국어, 3문장 이내)"
    },
    "prior_findings": {
      "type": "array",
      "description": "직전 라운드까지의 지적 각각에 대한 재판정. 1라운드는 빈 배열",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "note"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["resolved", "unresolved", "withdrawn"] },
          "note": { "type": "string", "description": "판정 근거. withdrawn은 반론을 받아들인 경우" }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "이번 라운드에 새로 발견한 지적만",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "category", "location", "problem", "evidence", "fix"],
        "properties": {
          "id": { "type": "string", "description": "R<라운드>-<번호>, 예: R1-3" },
          "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
          "category": {
            "type": "string",
            "enum": ["unmeasured-claim", "run-selection", "calc-error", "data-mismatch", "porting-fidelity", "scope-overclaim", "reproducibility", "method", "wording", "other"]
          },
          "location": { "type": "string", "description": "파일경로:줄 또는 파일경로#절" },
          "problem": { "type": "string" },
          "evidence": { "type": "string", "description": "직접 확인한 근거 (원자료 값, 명령 출력 등). 확인 못 했으면 그렇다고 적는다" },
          "fix": { "type": "string" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "description": "요청서 「결정 요청」의 항목마다 하나. 결정 요청이 없으면 빈 배열",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "choice", "agrees_with_claude", "rationale", "conditions", "escalate_to_user"],
        "properties": {
          "id": { "type": "string", "description": "요청서의 결정 id 그대로 (예: 결정 6)" },
          "choice": { "type": "string", "description": "고른 선택지 기호와 한 줄 요약. 새 선택지를 제안해도 된다" },
          "agrees_with_claude": { "type": "boolean" },
          "rationale": { "type": "string", "description": "직접 확인한 근거 포함" },
          "conditions": { "type": "string", "description": "이 선택을 할 때 반드시 지킬 조건·각주·기록. 없으면 빈 문자열" },
          "escalate_to_user": { "type": "boolean", "description": "둘이 정하면 안 되는 결정이라고 판단하면 true (이유는 rationale에)" }
        }
      }
    }
  }
}
